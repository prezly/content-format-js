{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build:all": {
      "dependsOn": [
        "build:ts",
        "build:esm",
        "build:commonjs"
      ]
    },
    "build:ts": {
      "dependsOn": [
        "^build:ts"
      ],
      "outputs": [
        "build/**",
        "dist/types/**",
        "tsconfig.tsbuildinfo"
      ]
    },
    "build:esm": {
      "dependsOn": [
        "build:ts"
      ],
      "outputs": [
        "dist/esm/**"
      ]
    },
    "build:commonjs": {
      "dependsOn": [
        "build:ts"
      ],
      "outputs": [
        "dist/commonjs/**"
      ]
    },
    "watch:ts": {
      "dependsOn": [
        "^build:ts"
      ],
      "cache": false,
      "persistent": true
    },
    "watch:esm": {
      "dependsOn": [
        "build:ts"
      ],
      "cache": false,
      "persistent": true
    },
    "watch:commonjs": {
      "dependsOn": [
        "build:ts"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build:ts",
        "build:esm",
        "build:commonjs"
      ],
      "outputs": []
    },
    "prettier": {
      "outputs": []
    },
    "prettier:fix": {
      "outputs": [],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "clean:build": {
      "cache": false
    },
    "clean:node_modules": {
      "cache": false
    }
  }
}
